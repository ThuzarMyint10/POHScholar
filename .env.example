APP_NAME="POH Scholarships Scheme"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Colombo
APP_URL=http://pohscholar.zagro.com/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=error

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poh_scholarships
DB_USERNAME=your_database_username
DB_PASSWORD=

# --- Sessions / cache ---
SESSION_DRIVER=file
SESSION_LIFETIME=180
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- File storage ---
FILESYSTEM_DISK=public

# --- Mail ---
# Use "log" for local testing. Configure SMTP when email delivery is required.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}" 

# --- Admin notifications ---
ADMIN_NOTIFICATION_EMAILS=admin@example.com

# --- Student document uploads ---
MAX_STUDENT_DOCUMENTS=5