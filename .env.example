APP_NAME="POH Scholarships Scheme"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Colombo
APP_URL=http://pohscholar.zagro.com/

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=error

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poh_scholarships
DB_USERNAME=your_database_username
DB_PASSWORD=

# --- Sessions / cache ---
SESSION_DRIVER=file
SESSION_LIFETIME=180
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- File storage ---
FILESYSTEM_DISK=public

# --- Mail ---
# Use "log" for local testing. Configure SMTP when email delivery is required.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}" 

# --- Admin notifications ---
ADMIN_NOTIFICATION_EMAILS=admin@example.com

# --- Student document uploads ---
MAX_STUDENT_DOCUMENTS=5

# Google reCAPTCHA: use "v2" for checkbox/image challenges or "v3" for invisible scoring.
RECAPTCHA_MODE=v2
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_EXPECTED_HOSTNAME=
# Optional: override only when using a Google-compatible verification endpoint.
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_TIMEOUT=10
RECAPTCHA_CA_BUNDLE=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=