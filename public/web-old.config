<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS URL Rewrite configuration for Laravel.

  This file belongs in the SITE'S DOCUMENT ROOT, which for a Laravel app
  is the /public folder - point your IIS site (or a subfolder-to-public
  mapping) at this /public directory, not at the project root.

  Requires the free "URL Rewrite" module for IIS:
    https://www.iis.net/downloads/microsoft/url-rewrite
  and PHP running via FastCGI (e.g. via the "PHP Manager for IIS" extension,
  or a PHP FastCGI handler already configured in IIS).
-->
<configuration>
  <system.webServer>

    <!-- Prevent directory browsing of /public. -->
    <directoryBrowse enabled="false" />

    <!-- Default document: index.php (Laravel's front controller). -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- Serve existing files/directories (css, js, images, storage
             symlink target, etc.) directly, without rewriting. -->
        <rule name="Laravel - existing files" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Everything else goes through Laravel's front controller. -->
        <rule name="Laravel - front controller" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <!-- Hide PHP version / server signature (optional hardening). -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- Reasonable upload size limit (matches the app's own 8MB PDF /
         4MB photo validation rules, with headroom) - raise if you need
         larger uploads. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>

  </system.webServer>

  <!-- If using classic PHP-FastCGI via web.config instead of IIS's own PHP
       handler mapping, uncomment and adjust the path to php-cgi.exe:
  <system.webServer>
    <handlers>
      <add name="PHP_via_FastCGI" path="*.php" verb="*" modules="FastCgiModule"
           scriptProcessor="C:\PHP\php-cgi.exe" resourceType="Either" />
    </handlers>
  </system.webServer>
  -->
</configuration>
